# ──────────────────────────────────────────────────────────────────────────────
# HyLocal — environment variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# Never commit .env to git — it contains secrets.
# ──────────────────────────────────────────────────────────────────────────────


# ── Telegram ──────────────────────────────────────────────────────────────────

# Bot token from @BotFather → /newbot
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Numeric chat ID of your curator group (negative number, e.g. -1001234567890)
# Get it by adding @userinfobot to the group and sending any message.
TELEGRAM_CURATOR_GROUP_ID=-1001234567890


# ── Supabase ──────────────────────────────────────────────────────────────────

# Project URL — Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# service_role key — Settings → API → service_role (keep this secret!)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ── AI providers ──────────────────────────────────────────────────────────────
# At least one of the following must be set for event extraction to work.

# Anthropic Claude (primary) — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (fallback, has free models) — https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-...

# OpenRouter model to use (default shown below — free tier, supports vision)
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free


# ── Geocoding ─────────────────────────────────────────────────────────────────

# Geoapify — free tier: 3,000 requests/day — https://www.geoapify.com/
GEOAPIFY_API_KEY=your-geoapify-key-here
